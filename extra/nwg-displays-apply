#!/usr/bin/env bash
# Noctalia calls `nwg-displays-apply -p <name>`.
# laptop, extend, and clone follow whichever monitor is plugged in.
set -euo pipefail

real=/usr/bin/nwg-displays-apply
args=("$@")
profile=
while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--profile)
      profile=${2:-}
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

script=${SWAYDOTS_DIR:-$HOME/swaydots}/extra/display-layout.sh
case "$profile" in
  laptop|extend|clone)
    exec "$script" "$profile"
    ;;
esac

exec "$real" "${args[@]}"
